# Runtime
NODE_ENV=development
PORT=5001
TRUST_PROXY_HOPS=0
REQUEST_BODY_LIMIT=1mb

# Frontend origins. Separate multiple origins with commas.
CLIENT_ORIGIN=http://localhost:5173

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/renaissance_2026
MONGO_SERVER_SELECTION_TIMEOUT_MS=10000
MONGO_MAX_POOL_SIZE=20
MONGO_MIN_POOL_SIZE=0

# Authentication secrets are required now so later auth parts can be added
# without changing the deployment contract. Use different random values.
JWT_ACCESS_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-another-random-secret-at-least-32-characters
